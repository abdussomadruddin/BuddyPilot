{
  "manifest_version": 3,
  "name": "BuddyPilot Post Pilot",
  "version": "1.3.0",
  "minimum_chrome_version": "120",
  "description": "Publish requested Threads posts and prepare Facebook drafts.",
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": ["https://buddypilot.vercel.app/*", "https://www.facebook.com/*", "https://www.threads.com/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_title": "BuddyPilot Post Pilot", "default_popup": "popup.html" }
}
